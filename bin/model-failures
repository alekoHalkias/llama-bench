#!/usr/bin/env python3
"""Collect every failed benchmark result, with the evidence needed for an RCA.

A result counts as failed when the model didn't load, the Claude Code session
ended in an error, or the task's check didn't pass. Writes results/failures.md
(rebuilt on every run) and prints a one-line summary per failure. Only runs from
the current design (results.csv has a "files" column) are included.
"""
import csv
import glob
import json
import os
import re

root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
results = os.environ.get("RESULTS", os.path.join(root, "results"))


def load_evidence(run_dir, safe):
    path = os.path.join(run_dir, f"{safe}.load.log")
    if not os.path.exists(path):
        return ["No load log (run is older than load logging)."]
    lines = open(path, errors="ignore").read().splitlines()
    # llama-server marks warnings/errors as " W " / " E "; keep those plus the llama-swap response
    keep = [l for l in lines if re.search(r"\s[EW]\s|error|fail", l, re.I)]
    return [f"Log: {os.path.relpath(path, results)}", "```", *(keep or lines)[-25:], "```"]


def session_evidence(path):
    if not os.path.exists(path):
        return ["No session log."]
    result, tool_errors, last_tools = None, [], []
    for line in open(path, errors="ignore"):
        try:
            d = json.loads(line)
        except Exception:
            continue
        if not isinstance(d, dict):
            continue
        if d.get("type") == "result":
            result = d
        msg = d.get("message")
        content = msg.get("content") if isinstance(msg, dict) else None
        for c in content if isinstance(content, list) else []:
            if not isinstance(c, dict):
                continue
            if c.get("type") == "tool_use":
                last_tools.append(f"{c.get('name')} {json.dumps(c.get('input'))[:150]}")
            elif c.get("type") == "tool_result" and c.get("is_error"):
                text = c.get("content")
                text = text if isinstance(text, str) else json.dumps(text)
                tool_errors.append(text.replace("\n", " ")[:200])
    out = [f"Log: {os.path.relpath(path, results)}"]
    if result is None:
        out.append("- Session never finished (no result line): crashed, killed, or cut off.")
    else:
        out.append(f"- Ended: subtype={result.get('subtype')}, terminal_reason={result.get('terminal_reason')}, "
                   f"is_error={result.get('is_error')}, api_error_status={result.get('api_error_status')}")
        final = str(result.get("result") or "").strip().replace("\n", " ")
        if final:
            out.append(f"- Final message: {final[:400]}")
        for den in result.get("permission_denials") or []:
            out.append(f"- Denied: {den.get('tool_name')} {json.dumps(den.get('tool_input'))[:150]}")
    if tool_errors:
        out.append(f"- Tool errors ({len(tool_errors)}), last 5:")
        out += [f"  - {e}" for e in tool_errors[-5:]]
    if last_tools:
        out.append(f"- Last tool calls (of {len(last_tools)}):")
        out += [f"  - {t}" for t in last_tools[-8:]]
    return out


def check_evidence(path):
    if not os.path.exists(path):
        return []
    lines = open(path, errors="ignore").read().splitlines()
    return [f"Check log: {os.path.relpath(path, results)}", "```", *lines[-15:], "```"]


entries, summary = [], []
for csv_path in sorted(glob.glob(os.path.join(results, "*", "results.csv"))):
    run_dir = os.path.dirname(csv_path)
    run = os.path.basename(run_dir)
    with open(csv_path, newline="") as f:
        reader = csv.DictReader(f)
        if "files" not in (reader.fieldnames or []):
            continue
        rows = list(reader)
    for r in rows:
        safe = re.sub(r"[^A-Za-z0-9._-]", "-", r["model"])
        base = os.path.join(run_dir, f"{safe}--{r['task']}")
        if r["error"] == "load-failed":
            kind, body = "load-failed", load_evidence(run_dir, safe)
        elif r["error"] == "yes" or r["check"] == "fail":
            kind = "session-error" if r["error"] == "yes" else "check-failed"
            files = sorted(os.path.relpath(p, base) for p in glob.glob(os.path.join(base, "**"), recursive=True)
                           if os.path.isfile(p))
            body = [f"- seconds={r['seconds']} turns={r['turns']} check={r['check']}",
                    f"- Files written ({len(files)}): {', '.join(files) or 'none'}",
                    *session_evidence(base + ".jsonl"), *check_evidence(base + ".check.log")]
        else:
            continue
        project = r.get("project", "-")
        summary.append(f"{run}  {r['model']:<16} {project:<12} {r['task']:<10} {kind}")
        entries.append("\n".join([f"## {run} / {r['model']} / {project} / {r['task']}: {kind}", "", *body, ""]))

out = os.path.join(results, "failures.md")
with open(out, "w") as f:
    f.write(f"# Benchmark failures\n\n{len(entries)} failed result(s). Rebuilt by `model-failures`.\n\n")
    f.write("\n".join(entries))
print("\n".join(summary) or "No failures.")
print(f"\nSaved: {out}")
